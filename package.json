{
  "name": "prayer-globe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prayer:check -- --horizon 11 && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prayer:discover": "node --experimental-strip-types scripts/prayer-data/discover.ts",
    "prayer:fetch": "node --experimental-strip-types scripts/prayer-data/fetch-times.ts",
    "prayer:select": "node --experimental-strip-types scripts/prayer-data/select-cities.ts",
    "prayer:check": "node --experimental-strip-types scripts/prayer-data/check-coverage.ts",
    "prayer:phases": "node --experimental-strip-types scripts/build-phases.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:world": "node --experimental-strip-types scripts/build-world.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "maplibre-gl": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.15",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.6"
  }
}
